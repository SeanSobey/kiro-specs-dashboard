{
  "name": "kiro-specs-dashboard",
  "displayName": "Kiro Specs Dashboard",
  "description": "Extension for visualizing and tracking Kiro spec features and tasks.",
  "version": "0.4.3",
  "publisher": "SeanSobey",
  "author": {
    "name": "SeanSobey"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanSobey/kiro-specs-dashboard"
  },
  "bugs": {
    "url": "https://github.com/SeanSobey/kiro-specs-dashboard/issues"
  },
  "homepage": "https://github.com/SeanSobey/kiro-specs-dashboard#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "kiro",
    "ai",
    "kiro ai",
    "kiro specs",
    "kiro ide",
    "kiro agent",
    "specs",
    "spec-driven-development",
    "spec driven",
    "dashboard",
    "tasks",
    "progress",
    "tracking",
    "project-management",
    "metrics",
    "pulse",
    "prompt",
    "execution",
    "saved-prompt",
    "profiles",
    "automation",
    "workflow",
    "templates",
    "agent",
    "productivity",
    "velocity",
    "analytics",
    "agile",
    "scrum",
    "kanban",
    "sprint"
  ],
  "activationEvents": [
    "workspaceContains:**/.kiro/specs/**/tasks.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "specs-dashboard.show",
        "title": "Show Specs Dashboard",
        "category": "Specs Dashboard"
      },
      {
        "command": "specs-dashboard.refresh",
        "title": "Refresh Specs Dashboard",
        "category": "Specs Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "specs-dashboard.generateMockData",
        "title": "Generate Mock Velocity Data",
        "category": "Specs Dashboard"
      },
      {
        "command": "specs-dashboard.clearVelocityData",
        "title": "Clear Velocity Data",
        "category": "Specs Dashboard"
      },
      {
        "command": "specs-dashboard.migrateVelocityData",
        "title": "Import Velocity Data from Git History",
        "category": "Specs Dashboard"
      },
      {
        "command": "specs-dashboard.openProfiles",
        "title": "Manage Profiles",
        "category": "Specs Dashboard",
        "icon": "$(person)"
      },
      {
        "command": "specs-dashboard.openAnalytics",
        "title": "Show Metrics",
        "category": "Specs Dashboard",
        "icon": "$(graph)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specs-dashboard-container",
          "title": "Kiro Specs",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "specs-dashboard-container": [
        {
          "id": "specs-dashboard.view",
          "name": "Dashboard",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Specs Dashboard",
      "properties": {
        "kiroSpecsDashboard.autoImportGitData": {
          "type": "boolean",
          "default": true,
          "description": "Automatically import velocity data from Git history when opening a workspace for the first time"
        },
        "kiroSpecsDashboard.specDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [".kiro/specs"],
          "description": "Directories to scan for spec files, relative to each workspace folder root. Supports multiple directories."
        },
        "kiroSpecsDashboard.extraFileLabels": {
          "type": "object",
          "default": {},
          "description": "Custom display labels for extra markdown files. Keys are file names without .md extension, values are display labels.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "kiroSpecsDashboard.extraFileVisibility": {
          "type": "object",
          "default": {},
          "description": "Control visibility of extra markdown files. Keys are file names without .md extension, values are booleans.",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "kiroSpecsDashboard.specFileConfig": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-file display configuration for spec panels. Keys are file names without `.md` extension (e.g. `tasks`, `test-cases`, `requirements`, `design`). An empty object (default) shows all files with default behaviour.\n\nExample:\n```json\n{\n  \"tasks\": { \"showStats\": true, \"showAction\": true },\n  \"test-cases\": { \"label\": \"Test Cases\", \"showStats\": true, \"showAction\": true, \"icon\": \"beaker\" },\n  \"requirements\": { \"showAction\": true },\n  \"design\": { \"showAction\": true },\n  \"acceptance-criteria\": { \"visible\": false }\n}\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Custom display label for this file."
              },
              "visible": {
                "type": "boolean",
                "default": true,
                "description": "Whether this file is visible at all. Set false to hide completely."
              },
              "showStats": {
                "type": "boolean",
                "description": "Show task progress stats panel (progress bar, counts) for task-like files. Defaults to true for task-like files."
              },
              "showAction": {
                "type": "boolean",
                "description": "Show as an action button at the bottom of the spec card. Defaults to true for standard files (requirements, design, tasks) and task-like extra files."
              },
              "icon": {
                "type": "string",
                "description": "VSCode codicon name for the action button (e.g. 'beaker', 'file', 'checklist'). Defaults vary by file type."
              }
            }
          }
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "specs-dashboard.refresh",
          "when": "view == specs-dashboard.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
	"package": "npx vsce package",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npx jest",
    "test:property": "npx jest --testPathPattern=property",
    "lint": "npx eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.74.0",
    "@types/jest": "^29.5.0",
    "@types/mocha": "^10.0.0",
    "@types/glob": "^8.1.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "fast-check": "^3.15.0",
    "mocha": "^10.2.0",
    "glob": "^8.1.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.35"
  }
}
